ASTERFORGE_ENVIRONMENT=development
ASTERFORGE_LOG_LEVEL=INFO
ASTERFORGE_DATABASE_URL=postgresql+asyncpg://asterforge:replace-with-a-strong-password@database:5432/asterforge
ASTERFORGE_CORS_ORIGINS=["http://localhost:4173"]
ASTERFORGE_SESSION_TTL_MINUTES=480
# Keep false only for plain-HTTP local development; production configuration must set true.
ASTERFORGE_SESSION_COOKIE_SECURE=false
ASTERFORGE_LOGIN_ATTEMPT_LIMIT=5
ASTERFORGE_LOGIN_ATTEMPT_WINDOW_MINUTES=15
ASTERFORGE_LOGIN_BLOCK_MINUTES=15
POSTGRES_DB=asterforge
POSTGRES_USER=asterforge
POSTGRES_PASSWORD=replace-with-a-strong-password
# Replace both placeholders only in the untracked deployment .env; never commit real credentials.
ASTERFORGE_BOOTSTRAP_ADMIN_USERNAME=<set-in-deployment-environment>
ASTERFORGE_BOOTSTRAP_ADMIN_PASSWORD=<set-a-unique-temporary-password>
# Generate a Fernet key once per deployment, store it as a secret, and keep it stable.
ASTERFORGE_INTEGRATION_ENCRYPTION_KEY=<set-a-fernet-key-in-deployment-environment>
# AMI collection is enabled in the canonical backend. Tune only for deployment needs.
ASTERFORGE_AMI_MONITORING_ENABLED=true
ASTERFORGE_AMI_CONNECT_TIMEOUT_SECONDS=5
ASTERFORGE_AMI_ACTION_TIMEOUT_SECONDS=5
ASTERFORGE_AMI_POLL_INTERVAL_SECONDS=30
ASTERFORGE_AMI_INVENTORY_REFRESH_SECONDS=10
ASTERFORGE_AMI_RECONNECT_MIN_SECONDS=1
ASTERFORGE_AMI_RECONNECT_MAX_SECONDS=60
# Enable only after a deployment-owned pipeline populates the normalized history tables.
ASTERFORGE_CDR_SOURCE=disabled
ASTERFORGE_CEL_SOURCE=disabled
# Optional read-only Prometheus node_exporter host telemetry. The exporter is contacted on each
# monitored server's inventory hostname, at this fixed port and the fixed /metrics path.
ASTERFORGE_HOST_TELEMETRY_ENABLED=false
ASTERFORGE_HOST_TELEMETRY_PORT=9100
ASTERFORGE_HOST_TELEMETRY_TIMEOUT_SECONDS=5
ASTERFORGE_HOST_TELEMETRY_POLL_INTERVAL_SECONDS=60
ASTERFORGE_HOST_TELEMETRY_INVENTORY_REFRESH_SECONDS=10
ASTERFORGE_HOST_TELEMETRY_RECORDING_MOUNTPOINT=/var/spool/asterisk/monitor
# Optional fixed-path Asterisk text-log ingestion. Stage each monitored server's log at
# log-sources/<server UUID>/messages; Compose mounts this directory read-only in the backend.
ASTERFORGE_LOG_INGESTION_ENABLED=false
ASTERFORGE_LOG_SOURCE_ROOT=/var/lib/asterforge/log-sources
ASTERFORGE_LOG_POLL_INTERVAL_SECONDS=5
ASTERFORGE_LOG_INVENTORY_REFRESH_SECONDS=10
ASTERFORGE_LOG_READ_MAX_BYTES=1048576
ASTERFORGE_LOG_READ_MAX_LINES=1000
ASTERFORGE_LOG_RETENTION_INTERVAL_SECONDS=3600